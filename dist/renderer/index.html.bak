          <div class="albedo-theme-preview-half" style="background:#22c55e"></div>
        </div>
        <div class="albedo-theme-name">Loki</div>
        <div class="albedo-theme-desc">Hacker Green</div>
      </div>
      <div class="albedo-theme-card" data-theme="doctor">
        <div class="albedo-theme-preview">
          <div class="albedo-theme-preview-half" style="background:#051620"></div>
          <div class="albedo-theme-preview-half" style="background:#06b6d4"></div>
        </div>
        <div class="albedo-theme-name">Doctor</div>
        <div class="albedo-theme-desc">Medical Teal</div>
      </div>
      <div class="albedo-theme-card" data-theme="aizen">
        <div class="albedo-theme-preview">
          <div class="albedo-theme-preview-half" style="background:#1a0e03"></div>
          <div class="albedo-theme-preview-half" style="background:#f59e0b"></div>
        </div>
