    </div>

  </div>
</div>

<div class="albedo-theme-toggle" id="albedo-theme-toggle" title="Vessel Controls">
  <svg viewBox="0 0 24 24">
    <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
  </svg>
</div>

<script>
(function() {
  const canvas = document.getElementById('albedo-bg');
  const ctx = canvas.getContext('2d');
  let W, H;
  
  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', () => {
    resize();
    // Reset caches on resize
    particles.length = 0;
    matrixColumns.length = 0;
    hexagons.length = 0;
    petals.length = 0;
  });
  resize();

  const themeRGBs = {
    albedo: '139, 92, 246',   // Purple
    loki: '34, 197, 94',      // Green
    doctor: '6, 182, 212',    // Teal
    aizen: '245, 158, 11',    // Amber Gold
    sakura: '244, 63, 94',    // Crimson Rose
    oled: '148, 163, 184'     // Slate/Grey
  };

  // State Settings (Load from localStorage)
  const settings = {
    theme: localStorage.getItem('albedo-theme-key') || 'albedo',
    bg: localStorage.getItem('albedo-bg-key') || 'particles',
    speed: parseFloat(localStorage.getItem('albedo-speed-val') || '1.0'),
    density: parseFloat(localStorage.getItem('albedo-density-val') || '1.0'),
    brightness: parseFloat(localStorage.getItem('albedo-brightness-val') || '0.15')
  };

  let activeThemeRGB = themeRGBs[settings.theme] || '139, 92, 246';

  // Animation Data Stores
  const particles = [];
  let matrixColumns = [];
  const hexagons = [];
  let gridOffset = 0;
  const petals = [];

  // ==========================================
  // Background Animation 1: Particles (Albedo)
  // ==========================================
  class Particle {
    constructor() { this.reset(); }
    reset() {
      this.x = Math.random() * W;
      this.y = Math.random() * H;
      this.vx = (Math.random() - 0.5) * 0.5;
      this.vy = (Math.random() - 0.5) * 0.5;
      this.r = Math.random() * 3 + 1;
      this.alpha = Math.random() * 0.4 + 0.1;
    }
    update() {
      this.x += this.vx * settings.speed;
      this.y += this.vy * settings.speed;
      if (this.x < 0 || this.x > W) this.vx *= -1;
      if (this.y < 0 || this.y > H) this.vy *= -1;
    }
  }
  function initParticles() {
    particles.length = 0;
    const count = Math.floor(75 * settings.density);
    for (let i = 0; i < count; i++) particles.push(new Particle());
  }
  function drawParticles() {
    if (particles.length === 0) initParticles();
    ctx.clearRect(0, 0, W, H);

    // Dynamic radial background glow
    const grad = ctx.createRadialGradient(W*0.5, H*0.3, 0, W*0.5, H*0.3, Math.max(W,H)*0.8);
    grad.addColorStop(0, `rgba(${activeThemeRGB}, ${settings.brightness})`);
    grad.addColorStop(0.5, `rgba(${activeThemeRGB}, ${settings.brightness * 0.5})`);
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // Draw Particles
    for (const p of particles) {
      p.update();
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${activeThemeRGB}, ${p.alpha})`;
      ctx.fill();
    }

    // Connect close nodes
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < 150) {
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.strokeStyle = `rgba(${activeThemeRGB}, ${0.06 * (1 - dist/150)})`;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }
  }

  // ==========================================
  // Background Animation 2: Matrix Rain (Loki)
  // ==========================================
  function initMatrix() {
    const fontSize = 14;
    const cols = Math.floor(W / fontSize) + 1;
    matrixColumns = Array(cols).fill(0).map(() => Math.random() * -100);
  }
  function drawMatrix() {
    if (matrixColumns.length === 0) initMatrix();

    ctx.fillStyle = `rgba(0, 0, 0, ${0.065 / settings.speed})`;
    ctx.fillRect(0, 0, W, H);

    const grad = ctx.createRadialGradient(W*0.5, H*0.3, 0, W*0.5, H*0.3, Math.max(W,H)*0.85);
    grad.addColorStop(0, `rgba(${activeThemeRGB}, ${settings.brightness * 0.75})`);
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    ctx.fillStyle = `rgba(${activeThemeRGB}, 0.8)`;
    ctx.font = '14px monospace';

    const fontSize = 14;
    const chars = '01010101010101010101LOKIALBEDO_SYSTEM_BYPASS';
    for (let i = 0; i < matrixColumns.length; i++) {
      if (Math.random() < 1 - settings.density * 0.8) continue;
      const char = chars[Math.floor(Math.random() * chars.length)];
      const x = i * fontSize;
      const y = matrixColumns[i] * fontSize;

      if (y > 0) {
        if (Math.random() > 0.95) ctx.fillStyle = '#ffffff';
        else ctx.fillStyle = `rgba(${activeThemeRGB}, 0.8)`;
        ctx.fillText(char, x, y);
      }

      if (y > H && Math.random() > 0.975) {
        matrixColumns[i] = 0;
      } else {
        matrixColumns[i] += settings.speed * 0.45;
      }
    }
  }

  // ==========================================
  // Background Animation 3: Molecules (Doctor)
  // ==========================================
  class Hexagon {
    constructor() { this.reset(); }
    reset() {
      this.x = Math.random() * W;
      this.y = Math.random() * H;
      this.size = Math.random() * 22 + 12;
      this.alpha = Math.random() * 0.2 + 0.05;
      this.speed = (Math.random() * 0.12 + 0.06) * settings.speed;
      this.angle = Math.random() * Math.PI * 2;
      this.rotSpeed = (Math.random() - 0.5) * 0.002 * settings.speed;
    }
    update() {
      this.x += Math.cos(this.angle) * this.speed;
      this.y += Math.sin(this.angle) * this.speed;
      this.angle += (Math.random() - 0.5) * 0.04;
      if (this.x < -50 || this.x > W + 50 || this.y < -50 || this.y > H + 50) {
        this.reset();
      }
    }
    draw() {
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        const a = (this.rotSpeed * Date.now() * 0.05) + (i * Math.PI) / 3;
        const hx = this.x + Math.cos(a) * this.size;
        const hy = this.y + Math.sin(a) * this.size;
        if (i === 0) ctx.moveTo(hx, hy);
        else ctx.lineTo(hx, hy);
      }
      ctx.closePath();
      ctx.strokeStyle = `rgba(${activeThemeRGB}, ${this.alpha})`;
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }
  function initHexagons() {
    hexagons.length = 0;
    const count = Math.floor(25 * settings.density);
    for (let i = 0; i < count; i++) hexagons.push(new Hexagon());
  }
  function drawHexagons() {
    if (hexagons.length === 0) initHexagons();
    ctx.clearRect(0, 0, W, H);

    const grad = ctx.createRadialGradient(W*0.5, H*0.3, 0, W*0.5, H*0.3, Math.max(W,H)*0.8);
    grad.addColorStop(0, `rgba(${activeThemeRGB}, ${settings.brightness})`);
    grad.addColorStop(0.5, `rgba(${activeThemeRGB}, ${settings.brightness * 0.5})`);
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    for (const h of hexagons) {
      h.update();
      h.draw();
    }

    for (let i = 0; i < hexagons.length; i++) {
      for (let j = i + 1; j < hexagons.length; j++) {
        const dx = hexagons[i].x - hexagons[j].x;
        const dy = hexagons[i].y - hexagons[j].y;
        const dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < 180) {
          ctx.beginPath();
          ctx.moveTo(hexagons[i].x, hexagons[i].y);
          ctx.lineTo(hexagons[j].x, hexagons[j].y);
          ctx.strokeStyle = `rgba(${activeThemeRGB}, ${0.05 * (1 - dist/180)})`;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }
  }

  // ==========================================
  // Background Animation 4: Retro Grid (Aizen)
  // ==========================================
  function drawGrid() {
    ctx.clearRect(0, 0, W, H);

    const grad = ctx.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, 'rgba(0,0,0,0)');
    grad.addColorStop(0.3, `rgba(${activeThemeRGB}, ${settings.brightness * 0.65})`);
    grad.addColorStop(0.7, `rgba(${activeThemeRGB}, ${settings.brightness * 0.85})`);
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    const horizon = H * 0.45;
    gridOffset = (gridOffset + settings.speed * 0.6) % 30;

    const lineCount = Math.floor(22 * settings.density);
    for (let i = 0; i < lineCount; i++) {
      const ratio = i / lineCount;
      const y = horizon + (H - horizon) * Math.pow(ratio, 2.5) + gridOffset * ((H - horizon) * Math.pow(ratio, 2.5) * 0.015);
      if (y > H) continue;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(W, y);
      const lineAlpha = 0.22 * ((y - horizon) / (H - horizon));
      ctx.strokeStyle = `rgba(${activeThemeRGB}, ${lineAlpha})`;
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    const center = W / 2;
    const vLineCount = Math.floor(32 * settings.density);
    for (let i = -vLineCount/2; i <= vLineCount/2; i++) {
      ctx.beginPath();
      ctx.moveTo(center, horizon);
      const targetX = center + i * (W / 12);
      ctx.lineTo(targetX, H);
      ctx.strokeStyle = `rgba(${activeThemeRGB}, 0.12)`;
      ctx.stroke();
    }
  }

  // ==========================================
  // Background Animation 5: Sakura (Sakura)
  // ==========================================
  class Petal {
    constructor() { this.reset(); }
    reset() {
      this.x = Math.random() * W;
      this.y = Math.random() * -100 - 10;
      this.size = Math.random() * 8 + 5;
      this.rot = Math.random() * Math.PI * 2;
      this.rotSpeed = (Math.random() - 0.5) * 0.02;
      this.vx = (Math.random() * 0.4 + 0.2);
      this.vy = (Math.random() * 0.7 + 0.3);
      this.sway = Math.random() * Math.PI * 2;
      this.swaySpeed = Math.random() * 0.015 + 0.005;
    }
    update() {
      this.x += (this.vx + Math.sin(this.sway) * 0.2) * settings.speed;
      this.y += this.vy * settings.speed;
      this.rot += this.rotSpeed * settings.speed;
      this.sway += this.swaySpeed * settings.speed;
      if (this.y > H + 20 || this.x > W + 20) {
        this.reset();
      }
    }
    draw() {
      ctx.save();
      ctx.translate(this.x, this.y);
      ctx.rotate(this.rot);

      ctx.beginPath();
      ctx.ellipse(0, 0, this.size, this.size * 0.6, 0, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${activeThemeRGB}, 0.6)`;
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(-this.size, 0);
      ctx.lineTo(this.size, 0);
      ctx.strokeStyle = `rgba(${activeThemeRGB}, 0.75)`;
      ctx.lineWidth = 0.5;
      ctx.stroke();

      ctx.restore();
    }
  }
  function initSakura() {
    petals.length = 0;
    const count = Math.floor(45 * settings.density);
    for (let i = 0; i < count; i++) petals.push(new Petal());
  }
  function drawSakura() {
    if (petals.length === 0) initSakura();
    ctx.clearRect(0, 0, W, H);

    const grad = ctx.createLinearGradient(0, 0, W, H);
    grad.addColorStop(0, `rgba(${activeThemeRGB}, ${settings.brightness * 0.75})`);
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    for (const p of petals) {
      p.update();
      p.draw();
    }
  }

  // ==========================================
  // Unified Animation Engine & State Router
  // ==========================================
  let animFrameId = null;
  function startLoop() {
    if (animFrameId) cancelAnimationFrame(animFrameId);
    if (settings.bg === 'none') {
      ctx.clearRect(0, 0, W, H);
      return;
    }
    loop();
  }

  function loop() {
    if (settings.bg === 'none') return;
    animFrameId = requestAnimationFrame(loop);

    activeThemeRGB = themeRGBs[settings.theme] || '139, 92, 246';

    switch(settings.bg) {
      case 'particles': drawParticles(); break;
      case 'matrix': drawMatrix(); break;
      case 'hexagons': drawHexagons(); break;
      case 'grid': drawGrid(); break;
      case 'sakura': drawSakura(); break;
    }
  }

  // ==========================================
  // DOM Controls & UI Event Observers
  // ==========================================
  const toggle = document.getElementById('albedo-theme-toggle');
  const drawer = document.getElementById('albedo-theme-drawer');
  const overlay = document.getElementById('albedo-theme-overlay');
  const closeBtn = document.getElementById('albedo-theme-drawer-close');

  function toggleDrawer() {
    drawer.classList.toggle('active');
    overlay.classList.toggle('active');
  }
  toggle.addEventListener('click', toggleDrawer);
  closeBtn.addEventListener('click', toggleDrawer);
  overlay.addEventListener('click', toggleDrawer);

  function applyTheme(themeKey) {
    document.documentElement.classList.remove('theme-albedo', 'theme-loki', 'theme-doctor', 'theme-aizen', 'theme-sakura', 'theme-oled');
    document.documentElement.classList.add('theme-' + themeKey);

    settings.theme = themeKey;
    localStorage.setItem('albedo-theme-key', themeKey);

    document.querySelectorAll('.albedo-theme-card').forEach(card => {
      const active = card.getAttribute('data-theme') === themeKey;
      card.classList.toggle('active', active);
      if (active) {
        const rgb = themeRGBs[themeKey];
        card.style.setProperty('--theme-active-color', `rgb(${rgb})`);
        card.style.setProperty('--theme-active-rgb', rgb);
      }
    });

    toggle.style.setProperty('--theme-primary-color', `rgb(${themeRGBs[themeKey]})`);
    toggle.style.setProperty('--theme-active-rgb', themeRGBs[themeKey]);
    
    // Dynamically retint background card indicators
    document.querySelectorAll('.albedo-bg-card').forEach(card => {
      if (card.classList.contains('active')) {
        const rgb = themeRGBs[themeKey];
        card.style.setProperty('--theme-active-color', `rgb(${rgb})`);
        card.style.setProperty('--theme-active-rgb', rgb);
      }
    });
  }

  function applyBackground(bgKey) {
    settings.bg = bgKey;
    localStorage.setItem('albedo-bg-key', bgKey);

    document.querySelectorAll('.albedo-bg-card').forEach(card => {
      const active = card.getAttribute('data-bg') === bgKey;
      card.classList.toggle('active', active);
      if (active) {
        const rgb = themeRGBs[settings.theme];
        card.style.setProperty('--theme-active-color', `rgb(${rgb})`);
        card.style.setProperty('--theme-active-rgb', rgb);
      }
    });

    particles.length = 0;
    matrixColumns.length = 0;
    hexagons.length = 0;
    petals.length = 0;

    startLoop();
  }

  document.querySelectorAll('.albedo-theme-card').forEach(card => {
    card.addEventListener('click', () => {
      applyTheme(card.getAttribute('data-theme'));
    });
  });

  document.querySelectorAll('.albedo-bg-card').forEach(card => {
    card.addEventListener('click', () => {
      applyBackground(card.getAttribute('data-bg'));
    });
  });

  // Bind Adjusters
  const speedSlider = document.getElementById('slider-speed');
  const valSpeed = document.getElementById('val-speed');
  speedSlider.addEventListener('input', (e) => {
    settings.speed = parseFloat(e.target.value);
    valSpeed.textContent = settings.speed.toFixed(1) + 'x';
    localStorage.setItem('albedo-speed-val', settings.speed);
  });

  const densitySlider = document.getElementById('slider-density');
  const valDensity = document.getElementById('val-density');
  densitySlider.addEventListener('input', (e) => {
    settings.density = parseFloat(e.target.value);
    valDensity.textContent = settings.density.toFixed(1) + 'x';
    localStorage.setItem('albedo-density-val', settings.density);
    // Reset buffers to dynamically adapt size counts
    particles.length = 0;
    hexagons.length = 0;
    petals.length = 0;
  });

  const brightnessSlider = document.getElementById('slider-brightness');
  const valBrightness = document.getElementById('val-brightness');
  brightnessSlider.addEventListener('input', (e) => {
    settings.brightness = parseFloat(e.target.value);
    valBrightness.textContent = Math.round(settings.brightness * 100) + '%';
    localStorage.setItem('albedo-brightness-val', settings.brightness);
  });

  // Intercept Fetch for Tavily Search
  try {
    const originalFetch = window.fetch;
    window.fetch = async function(url, options) {
      if (typeof url === 'string' && url.includes('api.tavily.com/search')) {
        try {
          const body = JSON.parse(options.body);
          const query = body.query;
          console.log("[Albedo-Search] Intercepted Tavily query:", query);
          if (window.albedoBridge && typeof window.albedoBridge.webSearch === 'function') {
            const results = await window.albedoBridge.webSearch(query);
            return new Response(JSON.stringify({ results }), {
              status: 200,
              headers: { 'Content-Type': 'application/json' }
            });
          }
        } catch(e) {
          console.error("[Albedo-Search] Fetch interception error:", e.message);
        }
      }
      return originalFetch.apply(this, arguments);
    };
    console.log("[Albedo-Search] Fetch interceptor active!");
  } catch(e) {
    console.error("[Albedo-Search] Failed to initialize interceptor:", e);
  }

  // Load initial settings
  applyTheme(settings.theme);
  applyBackground(settings.bg);

  speedSlider.value = settings.speed;
  valSpeed.textContent = settings.speed.toFixed(1) + 'x';

  densitySlider.value = settings.density;
  valDensity.textContent = settings.density.toFixed(1) + 'x';

  brightnessSlider.value = settings.brightness;
  valBrightness.textContent = Math.round(settings.brightness * 100) + '%';
})();
</script>
<div id=root></div><div class=splash-screen><div class=splash-screen-top></div><div class=splash-screen-content><div style="text-align:center"><div class=splash-screen-logo-bg style="font-size:280px;font-weight:900;opacity:0.08;color:#c8a0ff;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;user-select:none">A</div><div style="font-size:64px;color:#c8a0ff;filter:drop-shadow(0 0 30px rgba(150,60,200,0.6));line-height:1">A</div><div class=splash-screen-title>ALBEDO CHAT</div><div class=splash-screen-subtitle>powered by Dr. Ahmed</div></div><div class=splash-screen-bottom id=log-root></div></div></body></html>