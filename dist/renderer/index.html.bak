<!DOCTYPE html><html><head><meta charset=utf-8><meta name=viewport content="height=device-height,width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover"><meta name=apple-mobile-web-app-capable content=yes><meta name=apple-mobile-web-app-title content="Albedo Chat"><meta name=theme-color content=#0d0015><meta name=description content="Albedo Chat - Local AI Client with Albedo Bridge"><link rel=apple-touch-icon href=%PUBLIC_URL%/logo192.png><title>Albedo Chat</title><!-- TELEMETRY REMOVED --><link rel=icon href=./assets/icon.ico><script>var initialTheme = localStorage.getItem("initial-theme");
      if (initialTheme === "light" || initialTheme === "dark") {
        document.documentElement.setAttribute("data-theme", initialTheme);
        document.documentElement.setAttribute(
          "data-mantine-color-scheme",
          initialTheme
        );
      }</script><style>html[data-theme="dark"] {
        background-color: #242424;
      }

      .splash-screen {
        position: fixed;
        z-index: 99999;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        opacity: 1;
        background: linear-gradient(135deg, #1a0a2e 0%, #2d0a4e 25%, #3d0f5e 50%, #2a0a3e 75%, #0d0015 100%);
        overflow: hidden;
      }
      html[data-theme="dark"] .splash-screen {
        background: linear-gradient(135deg, #0a0015 0%, #1a0a2e 25%, #2d0a4e 50%, #1a0a2e 75%, #0a0015 100%);
      }

      .splash-screen::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at 30% 50%, rgba(120, 30, 180, 0.15) 0%, transparent 50%),
                    radial-gradient(circle at 70% 50%, rgba(200, 50, 50, 0.1) 0%, transparent 50%);
        animation: ambient-glow 8s ease-in-out infinite alternate;
      }

      @keyframes ambient-glow {
        0% { transform: translate(0, 0) rotate(0deg); }
        100% { transform: translate(2%, 1%) rotate(3deg); }
      }

      .splash-screen-top {
        flex: 2;
      }
      .splash-screen-bottom {
        flex: 3;
        width: 100%;
        position: relative;
      }
      .splash-screen-content {
        flex: 0 0 auto;
        position: relative;
        z-index: 1;
      }

      .splash-screen-logo {
        display: block;
        color: #e8d0ff;
        filter: drop-shadow(0 0 20px rgba(150, 60, 200, 0.5));
      }
      html[data-theme="dark"] .splash-screen-logo {
        color: #c8a0ff;
        filter: drop-shadow(0 0 30px rgba(150, 60, 200, 0.4));
      }

      .splash-screen-logo-bg {
        position: absolute;
        z-index: -1;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: rgba(80, 20, 120, 0.3);
      }
      html[data-theme="dark"] .splash-screen-logo-bg {
        color: rgba(60, 15, 100, 0.3);
      }

      .splash-screen-fade-out {
        animation: fade-out 0.5s ease-in-out forwards;
      }

      @keyframes fade-out {
        from {
          opacity: 1;
        }
        to {
          opacity: 0;
        }
      }

      .splash-screen-title {
        color: #c8a0ff;
        font-size: 24px;
        font-weight: bold;
        margin-top: 16px;
        text-shadow: 0 0 20px rgba(150, 60, 200, 0.6);
        font-family: 'Segoe UI', sans-serif;
        letter-spacing: 4px;
      }
      
      html[data-theme="dark"] .splash-screen-title {
        color: #b080e0;
      }

      .splash-screen-subtitle {
        color: #a080c0;
        font-size: 11px;
        margin-top: 6px;
        opacity: 0.7;
        letter-spacing: 2px;
      }</style><link rel=icon href=./favicon.ico><script defer=defer src=./assets/js/main.3920b58b9a28f5b33381.js></script><link href=./main.64e858dad79be53b1986.css rel=stylesheet></head><body>
<style>
.albedo-canvas-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
#root {
  position: relative;
  z-index: 1;
}
.splash-screen {
  z-index: 99999 !important;
}

/* Custom CSS Themes overrides */
.theme-loki {
  --theme-primary-color: #22c55e;
  --theme-primary-hover: #16a34a;
  --theme-bg-color: #030a05;
  --theme-card-bg: #06160b;
  --theme-border: #0c2614;
  --theme-input-bg: #091c0e;
  --theme-active-canvas-hue: 120;
}
.theme-doctor {
  --theme-primary-color: #06b6d4;
  --theme-primary-hover: #0891b2;
  --theme-bg-color: #020b10;
  --theme-card-bg: #051620;
  --theme-border: #0a2533;
  --theme-input-bg: #071c26;
  --theme-active-canvas-hue: 190;
}
.theme-aizen {
  --theme-primary-color: #f59e0b;
  --theme-primary-hover: #d97706;
  --theme-bg-color: #0d0601;
  --theme-card-bg: #1a0e03;
  --theme-border: #2c1908;
  --theme-input-bg: #221204;
  --theme-active-canvas-hue: 35;
}
.theme-sakura {
  --theme-primary-color: #f43f5e;
  --theme-primary-hover: #e11d48;
  --theme-bg-color: #0f0105;
  --theme-card-bg: #1e030c;
  --theme-border: #300816;
  --theme-input-bg: #260511;
  --theme-active-canvas-hue: 350;
}
.theme-oled {
  --theme-primary-color: #94a3b8;
  --theme-primary-hover: #64748b;
  --theme-bg-color: #000000;
  --theme-card-bg: #09090b;
  --theme-border: #18181b;
  --theme-input-bg: #0e0e11;
  --theme-active-canvas-hue: 200;
}
.theme-albedo {
  --theme-primary-color: #8b5cf6;
  --theme-primary-hover: #7c3aed;
  --theme-bg-color: #0b0218;
  --theme-card-bg: #15062c;
  --theme-border: #220b42;
  --theme-input-bg: #1c0937;
  --theme-active-canvas-hue: 270;
}

/* Global Overrides when theme class is active */
html.theme-loki, html.theme-doctor, html.theme-aizen, html.theme-sakura, html.theme-oled, html.theme-albedo {
  --mantine-color-body: var(--theme-bg-color) !important;
  
  --mantine-color-dark-7: var(--theme-bg-color) !important;
  --mantine-color-dark-6: var(--theme-card-bg) !important;
  --mantine-color-dark-8: var(--theme-bg-color) !important;
  --mantine-color-dark-5: var(--theme-input-bg) !important;
  --mantine-color-dark-4: var(--theme-border) !important;
  
  --mantine-color-blue-0: var(--theme-primary-color) !important;
  --mantine-color-blue-1: var(--theme-primary-color) !important;
  --mantine-color-blue-2: var(--theme-primary-color) !important;
  --mantine-color-blue-3: var(--theme-primary-color) !important;
  --mantine-color-blue-4: var(--theme-primary-color) !important;
  --mantine-color-blue-5: var(--theme-primary-color) !important;
  --mantine-color-blue-6: var(--theme-primary-color) !important;
  --mantine-color-blue-7: var(--theme-primary-hover) !important;
  --mantine-color-blue-8: var(--theme-primary-hover) !important;
  
  --mantine-color-blue-filled: var(--theme-primary-color) !important;
  --mantine-color-blue-filled-hover: var(--theme-primary-hover) !important;
  --mantine-color-blue-light: rgba(255, 255, 255, 0.08) !important;
  --mantine-color-blue-light-color: var(--theme-primary-color) !important;
  --mantine-color-blue-text: var(--theme-primary-color) !important;
}

/* Floating Settings Button */
.albedo-theme-toggle {
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: rgba(15, 10, 25, 0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5), 0 0 15px rgba(var(--theme-active-rgb, 139, 92, 246), 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  z-index: 9999;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.albedo-theme-toggle:hover {
  transform: scale(1.1) rotate(45deg);
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.6), 0 0 25px var(--theme-primary-color, #8b5cf6);
  border-color: var(--theme-primary-color, #8b5cf6);
}
.albedo-theme-toggle svg {
  width: 22px;
  height: 22px;
  fill: #e5e7eb;
  transition: fill 0.3s;
}
.albedo-theme-toggle:hover svg {
  fill: var(--theme-primary-color, #8b5cf6);
}

/* Sliding Switcher Panel Drawer */
.albedo-theme-drawer {
  position: fixed;
  top: 0;
  right: -360px;
  width: 330px;
  height: 100%;
  background: rgba(10, 5, 22, 0.88);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border-left: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: -10px 0 35px rgba(0, 0, 0, 0.65);
  z-index: 10000;
  transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  color: #e5e7eb;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  user-select: none;
}
.albedo-theme-drawer.active {
  right: 0;
}
.albedo-theme-drawer-header {
  padding: 22px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.albedo-theme-drawer-header h3 {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #fff;
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
}
.albedo-theme-drawer-header p {
  margin: 4px 0 0 0;
  font-size: 10px;
  color: #9ca3af;
  letter-spacing: 1px;
}
.albedo-theme-drawer-close {
  background: none;
  border: none;
  color: #9ca3af;
  font-size: 24px;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  transition: all 0.2s;
}
.albedo-theme-drawer-close:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
}
.albedo-theme-drawer-content {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}
.albedo-theme-section-title {
  font-size: 11px;
  font-weight: 600;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin: 0 0 12px 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.albedo-theme-section-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(255, 255, 255, 0.06);
}
.albedo-theme-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 24px;
}
.albedo-theme-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  padding: 12px;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.albedo-theme-card:hover {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.12);
  transform: translateY(-2px);
}
.albedo-theme-card.active {
  background: rgba(var(--theme-active-rgb, 139, 92, 246), 0.08);
  border-color: var(--theme-active-color, #8b5cf6);
  box-shadow: 0 0 10px rgba(var(--theme-active-rgb, 139, 92, 246), 0.25);
}
.albedo-theme-preview {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  margin-bottom: 8px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  overflow: hidden;
}
.albedo-theme-preview-half {
  flex: 1;
}
.albedo-theme-name {
  font-size: 12px;
  font-weight: 600;
  color: #f3f4f6;
  margin-bottom: 2px;
}
.albedo-theme-desc {
  font-size: 9px;
  color: #9ca3af;
}

/* Background Card Previews */
.albedo-bg-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  padding: 12px;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}
.albedo-bg-card:hover {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.12);
  transform: translateX(2px);
}
.albedo-bg-card.active {
  background: rgba(var(--theme-active-rgb, 139, 92, 246), 0.08);
  border-color: var(--theme-active-color, #8b5cf6);
  box-shadow: 0 0 10px rgba(var(--theme-active-rgb, 139, 92, 246), 0.25);
}
.albedo-bg-icon {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 16px;
}
.albedo-bg-info {
  flex: 1;
}
.albedo-bg-name {
  font-size: 12px;
  font-weight: 600;
  color: #f3f4f6;
}
.albedo-bg-desc {
  font-size: 9px;
  color: #9ca3af;
}

/* Controls / Sliders */
.albedo-control-group {
  margin-bottom: 20px;
}
.albedo-control-label {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: #9ca3af;
  margin-bottom: 8px;
  letter-spacing: 1px;
}
.albedo-control-val {
  font-weight: 600;
  color: #fff;
}
.albedo-slider {
  -webkit-appearance: none;
  width: 100%;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.08);
  outline: none;
}
.albedo-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--theme-primary-color, #8b5cf6);
  cursor: pointer;
  transition: transform 0.1s;
}
.albedo-slider::-webkit-slider-thumb:hover {
  transform: scale(1.2);
}

/* Overlay Backdrop */
.albedo-theme-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9998;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.albedo-theme-overlay.active {
  opacity: 1;
  pointer-events: all;
}
</style>
<canvas id="albedo-bg" class="albedo-canvas-bg"></canvas>

<!-- Switcher Interface HTML -->
<div class="albedo-theme-overlay" id="albedo-theme-overlay"></div>
<div class="albedo-theme-drawer" id="albedo-theme-drawer">
