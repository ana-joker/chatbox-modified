    <!-- ADJUSTERS SECTION -->
    <div class="albedo-theme-section-title" style="margin-top:24px">Engine Adjustments</div>
    
    <div class="albedo-control-group">
      <div class="albedo-control-label">
        <span>Animation Speed</span>
        <span class="albedo-control-val" id="val-speed">1.0x</span>
      </div>
      <input type="range" class="albedo-slider" id="slider-speed" min="0.1" max="2.5" step="0.1" value="1.0">
