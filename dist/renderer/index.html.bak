      <p>Configure cognitive layer</p>
    </div>
    <button class="albedo-theme-drawer-close" id="albedo-theme-drawer-close">&times;</button>
  </div>
  <div class="albedo-theme-drawer-content">
    
    <!-- UI THEMES SECTION -->
    <div class="albedo-theme-section-title">Color Theme</div>
    <div class="albedo-theme-grid">
      <div class="albedo-theme-card" data-theme="albedo">
        <div class="albedo-theme-preview">
          <div class="albedo-theme-preview-half" style="background:#15062c"></div>
          <div class="albedo-theme-preview-half" style="background:#8b5cf6"></div>
